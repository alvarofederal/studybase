// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────────
// MATÉRIA — ex: "Atualidades do Mercado Financeiro"
// ─────────────────────────────────────────────
model Materia {
  id        String   @id @default(cuid())
  nome      String
  slug      String   @unique
  descricao String?  @db.Text
  icone     String?
  cor       String?
  ativa     Boolean  @default(true)
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocos            Bloco[]
  userMaterias      UserMateria[]
  solicitacoes      SolicitacaoMateria[]
  lotesComentarioIa LoteComentarioIa[]

  @@map("materias")
}

// ─────────────────────────────────────────────
// BLOCO — agrupa tópicos dentro de uma matéria
// ─────────────────────────────────────────────
model Bloco {
  id        String   @id @default(cuid())
  nome      String
  slug      String
  descricao String?  @db.Text
  ordem     Int      @default(0)
  materiaId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materia Materia  @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  topicos Topico[]

  @@unique([materiaId, slug])
  @@map("blocos")
}

// ─────────────────────────────────────────────
// TÓPICO — conteúdo de estudo
// ─────────────────────────────────────────────
model Topico {
  id        String   @id @default(cuid())
  titulo    String
  slug      String
  conteudo  String   @db.LongText
  resumo    String?  @db.Text
  ordem     Int      @default(0)
  publicado Boolean  @default(true) // false = rascunho, invisível para alunos
  blocoId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bloco      Bloco       @relation(fields: [blocoId], references: [id], onDelete: Cascade)
  quizzes    Quiz[]
  flashcards Flashcard[]

  @@unique([blocoId, slug])
  @@map("topicos")
}

// ─────────────────────────────────────────────
// QUIZ — pergunta de múltipla escolha
// ─────────────────────────────────────────────
model Quiz {
  id          String      @id @default(cuid())
  pergunta    String      @db.Text
  explicacao  String?     @db.Text
  tipo        TipoQuiz    @default(MULTIPLA)
  origemId    String? // preenchido em itens CE derivados de uma múltipla escolha (só aparecem no simulado)
  dificuldade Dificuldade @default(MEDIO)
  tags        String?     @db.Text // valores separados por vírgula: "SFN,Regulação,Mercado"
  ordem       Int         @default(0)
  topicoId    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  topico       Topico                  @relation(fields: [topicoId], references: [id], onDelete: Cascade)
  opcoes       OpcaoQuiz[]
  respostas    RespostaQuiz[]
  historicos   HistoricoRespostaQuiz[]
  comentarios  ComentarioQuiz[]
  comentarioIa ComentarioIaQuiz?

  @@map("quizzes")
}

// MULTIPLA = 4 alternativas; CERTO_ERRADO = estilo CEBRASPE (assertiva + opções "Certo"/"Errado")
enum TipoQuiz {
  MULTIPLA
  CERTO_ERRADO
}

enum Dificuldade {
  FACIL
  MEDIO
  DIFICIL
}

// ─────────────────────────────────────────────
// OPÇÃO DE QUIZ
// ─────────────────────────────────────────────
model OpcaoQuiz {
  id      String  @id @default(cuid())
  texto   String  @db.Text
  correta Boolean @default(false)
  ordem   Int     @default(0)
  quizId  String

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("opcoes_quiz")
}

// ─────────────────────────────────────────────
// FLASHCARD — frente e verso para revisão
// ─────────────────────────────────────────────
model Flashcard {
  id        String   @id @default(cuid())
  frente    String   @db.Text
  verso     String   @db.LongText
  dica      String?  @db.Text
  ordem     Int      @default(0)
  topicoId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topico   Topico             @relation(fields: [topicoId], references: [id], onDelete: Cascade)
  revisoes RevisaoFlashcard[]

  @@map("flashcards")
}

// ─────────────────────────────────────────────
// USER — autenticação e controle de acesso
// ─────────────────────────────────────────────
model User {
  id         String    @id @default(cuid())
  nome       String
  email      String    @unique
  senha      String // bcrypt hash
  role       Role      @default(USER)
  ativo      Boolean   @default(true)
  metaDiaria Int       @default(20) // atividades (questões + flashcards) por dia
  dataProva  DateTime? // contagem regressiva no painel
  sessionId  String? // sessão única: o último login invalida os anteriores
  lastSeenAt DateTime? // presença: último sinal de vida (heartbeat)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  materias            UserMateria[]
  solicitacoes        SolicitacaoMateria[]
  respostasQuiz       RespostaQuiz[]
  revisoesFlashcard   RevisaoFlashcard[]
  historicosRespostas HistoricoRespostaQuiz[]
  comentarios         ComentarioQuiz[]
  comentarioCurtidas  ComentarioCurtida[]
  comentarioDenuncias ComentarioDenuncia[]

  @@map("users")
}

enum Role {
  ADMIN
  USER
}

// ─────────────────────────────────────────────
// REFRESH TOKEN — sessões JWT (7 dias)
// ─────────────────────────────────────────────
model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique // SHA-256 do token raw
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// PASSWORD RESET TOKEN — recuperação de senha
// ─────────────────────────────────────────────
model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usado     Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────
// USER MATERIA — quais matérias o usuário pode acessar
// ─────────────────────────────────────────────
model UserMateria {
  id        String    @id @default(cuid())
  userId    String
  materiaId String
  expiresAt DateTime? // null = legado sem expiração; novo padrão: +30 dias
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  materia Materia @relation(fields: [materiaId], references: [id], onDelete: Cascade)

  @@unique([userId, materiaId])
  @@map("user_materias")
}

// ─────────────────────────────────────────────
// SOLICITAÇÃO DE ACESSO — usuário pede permissão para uma matéria
// ─────────────────────────────────────────────
model SolicitacaoMateria {
  id        String            @id @default(cuid())
  userId    String
  materiaId String
  status    StatusSolicitacao @default(PENDENTE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  materia Materia @relation(fields: [materiaId], references: [id], onDelete: Cascade)

  @@unique([userId, materiaId])
  @@map("solicitacoes_materias")
}

enum StatusSolicitacao {
  PENDENTE
  APROVADA
  REJEITADA
}

// ─────────────────────────────────────────────
// RESPOSTA DE QUIZ — última resposta do usuário por questão
// ─────────────────────────────────────────────
model RespostaQuiz {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  opcaoId   String // opção escolhida
  correta   Boolean // denormalizado para queries rápidas
  topicoId  String // denormalizado para agrupamento por tópico
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId]) // upsert: uma resposta por questão por usuário
  @@map("respostas_quiz")
}

// ─────────────────────────────────────────────
// HISTÓRICO DE RESPOSTAS — todas as tentativas do usuário por questão
// ─────────────────────────────────────────────
model HistoricoRespostaQuiz {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  opcaoId   String // opção escolhida nesta tentativa
  correta   Boolean
  topicoId  String // denormalizado
  tentativa Int // 1ª, 2ª, 3ª tentativa...
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId, tentativa]) // evita tentativa duplicada em respostas simultâneas
  @@index([userId, createdAt])
  @@map("historico_respostas_quiz")
}

// ─────────────────────────────────────────────
// REVISÃO DE FLASHCARD — se o usuário soube ou não
// ─────────────────────────────────────────────
model RevisaoFlashcard {
  id             String    @id @default(cuid())
  userId         String
  flashcardId    String
  acertou        Boolean // true = "Sabia", false = "Não sabia"
  topicoId       String // denormalizado
  // Repetição espaçada (SM-2 simplificado)
  facilidade     Float     @default(2.5)
  intervaloDias  Int       @default(0)
  repeticoes     Int       @default(0)
  proximaRevisao DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId])
  @@index([userId, proximaRevisao])
  @@map("revisoes_flashcard")
}

// ─────────────────────────────────────────────
// COMENTÁRIOS DAS QUESTÕES — discussão entre alunos (estilo QC Concursos)
// Itens CE derivados comentam na questão de origem (origemId), para a conversa ser uma só.
// ─────────────────────────────────────────────
model ComentarioQuiz {
  id        String   @id @default(cuid())
  quizId    String
  userId    String
  paiId     String? // preenchido = resposta a outro comentário (1 nível)
  texto     String   @db.Text
  ocultado  Boolean  @default(false) // moderação: oculto aos alunos (admin pode reexibir)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quiz      Quiz                 @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  pai       ComentarioQuiz?      @relation("Respostas", fields: [paiId], references: [id], onDelete: Cascade)
  respostas ComentarioQuiz[]     @relation("Respostas")
  curtidas  ComentarioCurtida[]
  denuncias ComentarioDenuncia[]

  @@index([quizId, createdAt])
  @@index([ocultado, createdAt])
  @@map("comentarios_quiz")
}

model ComentarioCurtida {
  id           String   @id @default(cuid())
  comentarioId String
  userId       String
  createdAt    DateTime @default(now())

  comentario ComentarioQuiz @relation(fields: [comentarioId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([comentarioId, userId])
  @@map("comentario_curtidas")
}

model ComentarioDenuncia {
  id           String   @id @default(cuid())
  comentarioId String
  userId       String
  createdAt    DateTime @default(now())

  comentario ComentarioQuiz @relation(fields: [comentarioId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([comentarioId, userId])
  @@map("comentario_denuncias")
}

// ─────────────────────────────────────────────
// COMENTÁRIO COM IA — gerado uma vez por questão da trilha (spec/01 §8, ADR-01)
// ─────────────────────────────────────────────
model ComentarioIaQuiz {
  id             String   @id @default(cuid())
  quizId         String   @unique
  texto          String   @db.Text // Markdown simples
  alertaGabarito Boolean  @default(false) // a IA suspeita de erro no gabarito (fica retido até revisão)
  motivoAlerta   String?  @db.Text
  modelo         String
  revisado       Boolean  @default(false) // revisado pela equipe
  oculto         Boolean  @default(false) // oculto aos alunos
  geradoEm       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([alertaGabarito, revisado])
  @@map("comentarios_ia_quiz")
}

enum StatusLoteIa {
  ENVIADO
  COLETADO
  FALHOU
}

// Lote enviado à Message Batches API (50% do preço) — ADR-02
model LoteComentarioIa {
  id         String       @id @default(cuid())
  batchId    String       @unique
  materiaId  String
  total      Int
  status     StatusLoteIa @default(ENVIADO)
  sucesso    Int          @default(0)
  falhas     Int          @default(0)
  criadoEm   DateTime     @default(now())
  coletadoEm DateTime?

  materia Materia @relation(fields: [materiaId], references: [id], onDelete: Cascade)

  @@index([materiaId, status])
  @@map("lotes_comentario_ia")
}
